function calcAge(){

const value=$("x").value;

if(!value){

$("r").textContent=
"اختر تاريخ الميلاد.";

return;

}

const birth=
new Date(value+"T00:00:00");

const now=new Date();

if(birth>now){

$("r").textContent=
"التاريخ في المستقبل.";

return;

}

let years=
now.getFullYear()-
birth.getFullYear();

let months=
now.getMonth()-
birth.getMonth();

let days=
now.getDate()-
birth.getDate();

if(days<0){

months--;

days+=
new Date(
now.getFullYear(),
now.getMonth(),
0
).getDate();

}

if(months<0){

years--;

months+=12;

}

$("r").textContent=
`عمرك: ${years} سنة و ${months} شهر و ${days} يوم`;

}


function calcChange(){

const oldValue=Number($("a").value);

const newValue=Number($("b").value);

if(!oldValue){

$("r").textContent=
"القيمة القديمة لا تكون صفرًا.";

return;

}

const change=
(newValue-oldValue)/
oldValue*100;

$("r").textContent=

change>=0
?`الزيادة: ${change.toFixed(2)}%`
:`النقصان: ${Math.abs(change).toFixed(2)}%`;

}


