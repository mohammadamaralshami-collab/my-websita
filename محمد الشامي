class="task ${task.done?"done":""}"
>

<input
type="checkbox"
${task.done?"checked":""}
onchange="toggleTask(${index})"
>

<span>
${escapeHTML(task.text)}
</span>

<button
class="close"
onclick="deleteTask(${index})"
>
×
</button>

