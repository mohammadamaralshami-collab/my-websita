<!doctype html>
<html lang="ar" dir="rtl">

<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>مِفتاح | أدوات عربية مجانية</title>

<meta name="description" content="مِفتاح منصة عربية للأدوات الرقمية المجانية">

<style>

:root{
--bg:#07111f;
--card:#102035;
--card2:#142941;
--text:#f5f8ff;
--muted:#9db0c8;
--blue:#2f8cff;
--line:#ffffff16;
}

*{
box-sizing:border-box;
}

html{
scroll-behavior:smooth;
}

body{
margin:0;
font-family:Tahoma,Arial,sans-serif;
background:var(--bg);
color:var(--text);
line-height:1.7;
}

a{
text-decoration:none;
color:inherit;
}

button,
input,
textarea,
select{
font:inherit;
}

button{
cursor:pointer;
}

.container{
width:min(1150px,92%);
margin:auto;
}

/* الشريط العلوي */

header{
position:sticky;
top:0;
z-index:100;
background:#07111fee;
backdrop-filter:blur(12px);
border-bottom:1px solid var(--line);
}

nav{
min-height:68px;
display:flex;
align-items:center;
gap:18px;
flex-wrap:wrap;
padding:9px 0;
}

.logo{
font-size:22px;
font-weight:900;
white-space:nowrap;
}

.logo b{
display:inline-grid;
place-items:center;
width:40px;
height:40px;
border-radius:12px;
background:var(--blue);
margin-left:7px;
}

.links{
display:flex;
gap:5px;
overflow-x:auto;
flex:1;
scrollbar-width:none;
}

.links::-webkit-scrollbar{
display:none;
}

.links a{
white-space:nowrap;
color:var(--muted);
padding:9px 12px;
border-radius:9px;
}

.links a:hover{
background:#ffffff0c;
color:white;
}

/* الرئيسية */

.hero{
padding:70px 0;
}

.heroGrid{
display:grid;
grid-template-columns:1.2fr .8fr;
gap:28px;
align-items:center;
}

.tag{
color:#61b0ff;
border:1px solid #2f8cff44;
background:#2f8cff12;
display:inline-block;
padding:5px 12px;
border-radius:30px;
}

.hero h1{
font-size:clamp(40px,7vw,68px);
line-height:1.1;
margin:15px 0;
}

.hero h1 span{
color:#61b0ff;
}

.hero p{
color:var(--muted);
font-size:18px;
}

.box,
.tool,
.stat,
.info{
background:linear-gradient(145deg,var(--card),var(--card2));
border:1px solid var(--line);
border-radius:18px;
padding:20px;
}

.heroBox li{
padding:7px;
color:var(--muted);
}

.btn{
border:0;
border-radius:11px;
padding:10px 15px;
color:white;
background:var(--blue);
font-weight:700;
}

.btn.alt{
background:#ffffff0c;
border:1px solid var(--line);
}

.actions{
display:flex;
gap:8px;
flex-wrap:wrap;
margin-top:12px;
}

/* البحث */

.search{
display:flex;
gap:7px;
margin-top:20px;
}

.search input{
flex:1;
}

.search input,
.field input,
.field textarea,
.field select,
.modal input,
.modal textarea,
.modal select{
width:100%;
background:#081625;
color:white;
border:1px solid var(--line);
border-radius:11px;
padding:11px;
outline:none;
}

/* الإحصائيات */

.stats{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:12px;
}

.stat{
text-align:center;
}

.stat strong{
display:block;
font-size:27px;
color:#61b0ff;
}

.stat small{
color:var(--muted);
}

/* الأقسام */

section{
padding:60px 0;
scroll-margin-top:90px;
}

.title{
text-align:center;
margin-bottom:28px;
}

.title h2{
font-size:34px;
margin:0 0 5px;
}

.title p{
color:var(--muted);
margin:0;
}

/* الفلاتر */

.filters{
display:flex;
gap:7px;
flex-wrap:wrap;
margin-bottom:20px;
}

.filter{
border:1px solid var(--line);
background:var(--card);
color:var(--muted);
padding:8px 13px;
border-radius:10px;
}

.filter.active{
background:var(--blue);
color:#fff;
}

/* الأدوات */

.grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:14px;
}

.tool{
position:relative;
}

.toolIcon{
font-size:30px;
}

.tool p,
.info p{
color:var(--muted);
font-size:14px;
}

.fav{
position:absolute;
left:12px;
top:12px;
border:1px solid var(--line);
background:#ffffff08;
color:#ffd15c;
border-radius:9px;
width:34px;
height:34px;
}

/* النماذج */

.field{
margin:12px 0;
}

.row{
display:grid;
grid-template-columns:1fr 1fr;
gap:10px;
}

.result{
white-space:pre-wrap;
overflow-wrap:anywhere;
background:#081625;
border:1px solid var(--line);
border-radius:11px;
padding:13px;
margin-top:12px;
}

/* البطاقة */

.cardPreview{
display:none;
margin-top:18px;
padding:35px 20px;
text-align:center;
border-radius:24px;
background:linear-gradient(145deg,#15365c,#081625);
border:1px solid #61b0ff55;
}

.cardPreview.show{
display:block;
}

.cardPreview h3{
font-size:30px;
margin:7px;
}

/* المهام */

.tasks{
display:grid;
gap:8px;
}

.task{
display:flex;
gap:10px;
align-items:center;
background:var(--card);
border:1px solid var(--line);
padding:10px;
border-radius:10px;
}

.task span{
flex:1;
}

.done span{
text-decoration:line-through;
color:#667891;
}

/* الإعلان */

.ad{
border:1px dashed #ffffff22;
color:#63748b;
text-align:center;
padding:25px;
border-radius:15px;
margin:20px 0;
}

/* النافذة */

.modal{
display:none;
position:fixed;
inset:0;
background:#000b;
z-index:500;
padding:18px;
align-items:center;
justify-content:center;
}

.modal.show{
display:flex;
}

.modalBox{
width:min(720px,100%);
max-height:90vh;
overflow:auto;
background:var(--card);
border:1px solid var(--line);
border-radius:20px;
padding:22px;
}

.modalHead{
display:flex;
justify-content:space-between;
align-items:center;
}

.close{
border:1px solid var(--line);
background:#ffffff0a;
color:#fff;
border-radius:9px;
width:38px;
height:38px;
font-size:22px;
}

/* الفوتر */

footer{
border-top:1px solid var(--line);
padding:40px 0;
color:var(--muted);
}

/* الهاتف */

@media(max-width:850px){

.heroGrid{
grid-template-columns:1fr;
}

.grid{
grid-template-columns:1fr 1fr;
}

.stats{
grid-template-columns:1fr 1fr;
}

}

@media(max-width:560px){

.grid{
grid-template-columns:1fr;
}

.row{
grid-template-columns:1fr;
}

.hero{
padding:45px 0;
}

.hero h1{
font-size:42px;
}

}

</style>
</head>


