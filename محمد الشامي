atob($("x").value.trim());

const bytes=
Uint8Array.from(
binary,
c=>c.charCodeAt(0)
);

$("r").textContent=
new TextDecoder()
.decode(bytes);

}catch{

$("r").textContent=
"النص غير صالح.";

}

}


